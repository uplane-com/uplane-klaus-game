{
  "name": "@office/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "keys": "tsx --env-file-if-exists=.env scripts/keys.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@office/events": "workspace:*",
    "hono": "^4.13.8",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
