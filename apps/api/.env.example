# Neon: pooled connection string for queries (host contains "-pooler").
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/office?sslmode=require
# Neon: direct (unpooled) connection for LISTEN/NOTIFY. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/office?sslmode=require
PORT=8080
# Agents that send nothing for this long are marked as stopped.
STALE_AFTER_SECONDS=900
# Allow reading snapshot/stream without an API key (e.g. internal network only).
PUBLIC_READ=false
# Comma-separated origins allowed to call the API from a browser (dev: http://localhost:5173).
CORS_ORIGINS=http://localhost:5173
# Built visualisation to serve at / (set in the Docker image).
STATIC_DIR=
# Secret of the GitHub org webhook (POST /v1/github; events: workflow_job, deployment_status).
GITHUB_WEBHOOK_SECRET=
# Deployment environments that are NOT shown (default: staging,stage,stg,preview,dev,develop,development,qa,sandbox).
# GITHUB_HIDDEN_ENVIRONMENTS=staging,preview
